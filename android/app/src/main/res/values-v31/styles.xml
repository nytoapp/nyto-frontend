<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Image 1 is the window background from frame 0.
      Silent splash icon avoids the floating logo plate.
      Do not use Theme.SplashScreen + installSplashScreen (that kept black longer).
    -->
    <style name="BootTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/nyto_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_silent_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nyto_ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
